{
  "manifest_version": 3,
  "name": "OverlayHub",
  "version": "1.0.0",
  "description": "One-click overlay tools for GitHub repos. Reads the current owner/repo and opens GitDiagram, GitIngest, DeepWiki, and more.",
  "action": {
    "default_title": "OverlayHub",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["tools.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
